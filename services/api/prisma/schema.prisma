  id              String    @id @default(uuid()) @db.Uuid
  syncOperationId String    @unique @map("sync_operation_id") @db.Uuid
  entity          String
  conflictType    String    @map("conflict_type")
  localData       Json      @map("local_data")
  serverData      Json      @map("server_data")
  resolution      String?
  resolverId      String?   @map("resolver_id") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Restrict)
  resolver      User?         @relation(fields: [resolverId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entity])
  @@index([conflictType])
  @@map("conflicts")
}

