generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  inactive
}

enum StoreStatus {
  active
  inactive
}

enum RegisterStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum RoleStatus {
  active
  inactive
}

enum PermissionStatus {
  active
  inactive
}

enum CategoryStatus {
  active
  inactive
}

enum BrandStatus {
  active
  inactive
}

enum UnitStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
}

enum TaxCategoryStatus {
  active
  inactive
}

enum InventoryLocationStatus {
  active
  inactive
}

enum SupplierStatus {
  active
  inactive
}

enum CustomerStatus {
  active
  inactive
}

enum ExpenseCategoryStatus {
  active
  inactive
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  legalName String             @map("legal_name")
  panNumber String?            @map("pan_number")
  vatNumber String?            @map("vat_number")
  contact   String?
  address   String?
  currency  String
  timezone  String             @default("Asia/Kathmandu")
  status    OrganizationStatus @default(active)

  stores             Store[]
  users              User[]
  roles              Role[]
  categories         Category[]
  brands             Brand[]
  units              Unit[]
  products           Product[]
  unitConversions    UnitConversion[]
  productBarcodes    ProductBarcode[]
  taxCategories      TaxCategory[]
  inventoryMovements InventoryMovement[]
  suppliers          Supplier[]
  customers          Customer[]
  sales              Sale[]
  payments           Payment[]
  expenseCategories  ExpenseCategory[]
  cashSessions       CashSession[]
  devices            Device[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizations")
}

model Store {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  code           String
  address        String?
  phone          String?
  status         StoreStatus @default(active)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registers          Register[]
  userStoreAccess    UserStoreAccess[]
  inventoryLocations InventoryLocation[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  expenses           Expense[]
  cashSessions       CashSession[]
  devices            Device[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@map("stores")
}

model Register {
  id       String         @id @default(uuid()) @db.Uuid
  storeId  String         @map("store_id") @db.Uuid
  name     String
  code     String
  deviceId String?        @unique @map("device_id") @db.Uuid
  status   RegisterStatus @default(active)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  device       Device?       @relation("RegisterDevice", fields: [deviceId], references: [id], onDelete: Restrict)
  deviceLink   Device?       @relation("DeviceRegister")
  sales        Sale[]
  cashSessions CashSession[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, code])
  @@map("registers")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  email          String?    @unique
  phone          String?    @unique
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(active)
  lastLogin      DateTime?  @map("last_login") @db.Timestamptz(6)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles             UserRole[]
  storeAccess       UserStoreAccess[]
  refreshTokens     RefreshToken[]
  createdMovements  InventoryMovement[] @relation("MovementCreator")
  sales             Sale[]
  cashSessions      CashSession[]
  auditLogs         AuditLog[]
  resolvedConflicts Conflict[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Role {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  code           String
  description    String?
  status         RoleStatus @default(active)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  status      PermissionStatus @default(active)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserStoreAccess {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, storeId])
  @@map("user_store_access")
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  parentId       String?        @map("parent_id") @db.Uuid
  name           String
  status         CategoryStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, name])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  status         BrandStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, name])
  @@map("brands")
}

model Unit {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  code           String
  precision      Int
  status         UnitStatus @default(active)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products        Product[]
  conversionsFrom UnitConversion[] @relation("UnitConversionFrom")
  conversionsTo   UnitConversion[] @relation("UnitConversionTo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@map("units")
}

model UnitConversion {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  fromUnitId     String  @map("from_unit_id") @db.Uuid
  toUnitId       String  @map("to_unit_id") @db.Uuid
  multiplier     Decimal @db.Decimal(14, 6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromUnit     Unit         @relation("UnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit       Unit         @relation("UnitConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, fromUnitId, toUnitId])
  @@index([toUnitId])
  @@map("unit_conversions")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  categoryId           String?       @map("category_id") @db.Uuid
  brandId              String?       @map("brand_id") @db.Uuid
  unitId               String?       @map("unit_id") @db.Uuid
  taxCategoryId        String?       @map("tax_category_id") @db.Uuid
  name                 String
  description          String?
  sku                  String
  defaultPurchasePrice Decimal?      @map("default_purchase_price") @db.Decimal(14, 2)
  defaultSellingPrice  Decimal?      @map("default_selling_price") @db.Decimal(14, 2)
  reorderLevel         Decimal?      @map("reorder_level") @db.Decimal(14, 3)
  reorderQuantity      Decimal?      @map("reorder_quantity") @db.Decimal(14, 3)
  status               ProductStatus @default(active)

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category           Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit               Unit?                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxCategory        TaxCategory?          @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  barcodes           ProductBarcode[]
  prices             ProductPrice[]
  batches            ProductBatch[]
  balances           InventoryBalance[]
  movements          InventoryMovement[]
  adjustmentItems    StockAdjustmentItem[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       GoodsReceiptItem[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@map("products")
}

model ProductBarcode {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  barcode        String
  barcodeType    String? @map("barcode_type")
  isPrimary      Boolean @default(false) @map("is_primary")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, barcode])
  @@index([barcode])
  @@index([productId])
  @@map("product_barcodes")
}

model TaxCategory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  code           String
  rate           Decimal           @db.Decimal(14, 4)
  taxType        String            @map("tax_type")
  effectiveFrom  DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?         @map("effective_to") @db.Timestamptz(6)
  status         TaxCategoryStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@map("tax_categories")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  priceType     String    @map("price_type")
  amount        Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId, priceType, effectiveFrom])
  @@map("product_prices")
}

model ProductBatch {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  supplierId      String?   @map("supplier_id") @db.Uuid
  batchNumber     String    @map("batch_number")
  manufactureDate DateTime? @map("manufacture_date") @db.Timestamptz(6)
  expiryDate      DateTime? @map("expiry_date") @db.Timestamptz(6)
  unitCost        Decimal   @map("unit_cost") @db.Decimal(14, 2)

  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  balances        InventoryBalance[]
  movements       InventoryMovement[]
  adjustmentItems StockAdjustmentItem[]
  transferItems   StockTransferItem[]
  receiptItems    GoodsReceiptItem[]
  saleItems       SaleItem[]
  allocations     SaleItemAllocation[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId, expiryDate])
  @@map("product_batches")
}

model InventoryBalance {
  id             String  @id @default(uuid()) @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  batchId        String? @map("batch_id") @db.Uuid
  quantityOnHand Decimal @map("quantity_on_hand") @db.Decimal(14, 3)
  reserved       Decimal @default(0) @db.Decimal(14, 3)
  available      Decimal @default(0) @db.Decimal(14, 3)
  version        Int     @default(1)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch    ProductBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([locationId, productId, batchId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  movementType   String   @map("movement_type")
  quantity       Decimal  @db.Decimal(14, 3)
  unitCost       Decimal? @map("unit_cost") @db.Decimal(14, 2)
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id") @db.Uuid
  operationId    String?  @map("operation_id")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdById    String?  @map("created_by") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch        ProductBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("MovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
  @@index([locationId, productId, batchId, occurredAt])
  @@index([operationId])
  @@map("inventory_movements")
}

model StockAdjustment {
  id          String    @id @default(uuid()) @db.Uuid
  locationId  String    @map("location_id") @db.Uuid
  reason      String
  status      String
  notedAt     DateTime  @map("noted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items    StockAdjustmentItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String  @id @default(uuid()) @db.Uuid
  adjustmentId String  @map("adjustment_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  batchId      String? @map("batch_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      ProductBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_adjustment_items")
}

model StockTransfer {
  id                    String    @id @default(uuid()) @db.Uuid
  sourceLocationId      String    @map("source_location_id") @db.Uuid
  destinationLocationId String    @map("destination_location_id") @db.Uuid
  status                String
  transferredAt         DateTime  @map("transferred_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)

  sourceLocation      InventoryLocation   @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation InventoryLocation   @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items               StockTransferItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String  @id @default(uuid()) @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  batchId    String? @map("batch_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch    ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_transfer_items")
}

model InventoryLocation {
  id      String                  @id @default(uuid()) @db.Uuid
  storeId String                  @map("store_id") @db.Uuid
  name    String
  code    String
  status  InventoryLocationStatus @default(active)

  store                Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  balances             InventoryBalance[]
  movements            InventoryMovement[]
  adjustments          StockAdjustment[]
  transfersSource      StockTransfer[]     @relation("TransferSource")
  transfersDestination StockTransfer[]     @relation("TransferDestination")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, code])
  @@map("inventory_locations")
}

model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  code           String
  panNumber      String?        @map("pan_number")
  contact        String?
  paymentTerms   String?        @map("payment_terms")
  creditLimit    Decimal?       @map("credit_limit") @db.Decimal(14, 2)
  status         SupplierStatus @default(active)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  ledgerEntries  SupplierLedgerEntry[]
  payments       SupplierPayment[]
  batches        ProductBatch[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String    @id @default(uuid()) @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  status         String
  orderDate      DateTime  @map("order_date") @db.Timestamptz(6)
  expectedDate   DateTime? @map("expected_date") @db.Timestamptz(6)
  subTotal       Decimal   @default(0) @map("sub_total") @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([supplierId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
